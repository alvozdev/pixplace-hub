# Server settings. Platform keys are entered in the admin panel, not here.
ADMIN_PASSWORD=          # password for the hub
HUB_SECRET=              # 32+ random chars: signs sessions and encrypts stored keys
# Encrypted key storage. Connecting Upstash in Vercel → Storage sets KV_REST_API_URL
# and KV_REST_API_TOKEN automatically; UPSTASH_REDIS_REST_URL/TOKEN also work.
# Local development without them stores keys in .data/.
